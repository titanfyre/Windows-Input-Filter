[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=WindowsInputFilterControl.cat
DriverVer=10/24/2026,0.1.0.0
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTamd64.10.0...16299
[Models.NTamd64.10.0...16299]
%Name%=Control,ROOT\WindowsInputFilterControl
[Control.NT]
CopyFiles=Files
[Control.NT.Services]
AddService=WindowsInputFilter,2,Service
AddService=WindowsInputFilterDemoClock,0,TrialClockService
[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\WindowsInputFilter.sys
[Control.NT.Wdf]
KmdfService=WindowsInputFilter,Wdf
[Wdf]
KmdfLibraryVersion=1.15
[DestinationDirs]
Files=13
[Files]
DemoSessionClock.sys
WindowsInputFilter.sys
[SourceDisksNames]
1=%Provider%,,,
[SourceDisksFiles]
DemoSessionClock.sys=1
WindowsInputFilter.sys=1
[Strings]
Provider="InputFilter Project"
Name="InputFilter Control Endpoint"
ServiceName="WindowsInputFilter"

[TrialClockService]
DisplayName="TitanCSA per-boot demo clock"
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\DemoSessionClock.sys
